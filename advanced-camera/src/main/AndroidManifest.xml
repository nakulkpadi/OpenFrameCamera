<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application>
        <activity android:name="in.advancedcamera.sdk.AdvancedCameraActivity"
            android:exported="false" android:screenOrientation="unspecified"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <provider android:name="in.advancedcamera.sdk.AdvancedCameraFileProvider"
            android:authorities="${applicationId}.advancedcamera.fileprovider"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/advanced_camera_paths"/>
        </provider>
    </application>
</manifest>
